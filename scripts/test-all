#!/bin/zsh
set -euo pipefail
WORKSPACE_DIR=${0:A:h:h}
pnpm --dir "$WORKSPACE_DIR/components/protocol" validate
pnpm --dir "$WORKSPACE_DIR/components/sdk" typecheck
pnpm --dir "$WORKSPACE_DIR/components/sdk" test
pnpm --dir "$WORKSPACE_DIR/components/sdk" build
pnpm --dir "$WORKSPACE_DIR/components/browser" security:verify
pnpm --dir "$WORKSPACE_DIR/components/browser" typecheck
pnpm --dir "$WORKSPACE_DIR/components/browser" test
pnpm --dir "$WORKSPACE_DIR/components/browser" build
uv run --project "$WORKSPACE_DIR/components/engine" --directory "$WORKSPACE_DIR/components/engine" pytest
uv build --project "$WORKSPACE_DIR/components/engine"
pnpm --dir "$WORKSPACE_DIR/components/examples" test
node "$WORKSPACE_DIR/scripts/check-public-docs.mjs" --all
