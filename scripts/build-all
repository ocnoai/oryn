#!/bin/zsh
set -euo pipefail
WORKSPACE_DIR=${0:A:h:h}
pnpm --dir "$WORKSPACE_DIR/components/protocol" build
pnpm --dir "$WORKSPACE_DIR/components/sdk" build
pnpm --dir "$WORKSPACE_DIR/components/browser" build
uv build --project "$WORKSPACE_DIR/components/engine"
pnpm --dir "$WORKSPACE_DIR/components/examples" build
