#!/bin/zsh
set -euo pipefail

WORKSPACE_DIR=${0:A:h:h}
ARTIFACT_DIR="$WORKSPACE_DIR/.workspace-artifacts"
# Source recognition is qualified against this exact CPython parser patch.
PYTHON_VERSION=3.12.16
PNPM_FETCH_FLAGS=()
UV_FETCH_FLAGS=()
if [[ "${ORYN_OFFLINE:-0}" == "1" ]]; then
  PNPM_FETCH_FLAGS=(--offline)
  UV_FETCH_FLAGS=(--offline)
fi

for tool in node pnpm uv; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    print -u2 "$tool is required to bootstrap Oryn."
    exit 1
  fi
done
if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
  print -u2 "The current Oryn source workflow requires Apple Silicon macOS."
  exit 1
fi
for project in oryn-browser oryn-engine oryn-sdk oryn-protocol oryn-examples; do
  if [[ ! -f "$WORKSPACE_DIR/projects/$project/README.md" ]]; then
    print -u2 "Missing public project source: projects/$project"
    exit 1
  fi
done

# Registry is an opaque, versioned dependency in this source distribution.
# Verify the bundled Registry package and reviewed third-party wheels before install.
node "$WORKSPACE_DIR/scripts/verify-vendor-artifacts.mjs"
/bin/mkdir -p "$ARTIFACT_DIR" "$WORKSPACE_DIR/projects/oryn-browser/vendor" "$WORKSPACE_DIR/projects/oryn-engine/vendor" "$WORKSPACE_DIR/projects/oryn-examples/vendor"

print "Building Oryn Protocol from source…"
pnpm --dir "$WORKSPACE_DIR/projects/oryn-protocol" install --frozen-lockfile "${PNPM_FETCH_FLAGS[@]}"
node "$WORKSPACE_DIR/projects/oryn-protocol/scripts/sync-chat-formats.mjs" "$WORKSPACE_DIR/projects/oryn-engine/build-inputs/chat-formats.json"
pnpm --dir "$WORKSPACE_DIR/projects/oryn-protocol" sync:schema
uv sync --project "$WORKSPACE_DIR/projects/oryn-protocol/python" --python "$PYTHON_VERSION" --extra dev --frozen "${UV_FETCH_FLAGS[@]}"
pnpm --dir "$WORKSPACE_DIR/projects/oryn-protocol/typescript" build
uv build --project "$WORKSPACE_DIR/projects/oryn-protocol/python" --python "$PYTHON_VERSION" "${UV_FETCH_FLAGS[@]}"
/usr/bin/install -m 0644 "$WORKSPACE_DIR/projects/oryn-protocol/LICENSE" "$WORKSPACE_DIR/projects/oryn-protocol/typescript/LICENSE"
pnpm --dir "$WORKSPACE_DIR/projects/oryn-protocol/typescript" pack --pack-destination "$ARTIFACT_DIR"
PROTOCOL_VERSION="$(node -p 'require(process.argv[1]).version' "$WORKSPACE_DIR/projects/oryn-protocol/typescript/package.json")"
/usr/bin/install -m 0644 "$ARTIFACT_DIR/ocno-oryn-protocol-$PROTOCOL_VERSION.tgz" "$WORKSPACE_DIR/projects/oryn-browser/vendor/ocno-oryn-protocol-$PROTOCOL_VERSION.tgz"
/usr/bin/install -m 0644 "$WORKSPACE_DIR/projects/oryn-protocol/python/dist/oryn_protocol-$PROTOCOL_VERSION-py3-none-any.whl" "$WORKSPACE_DIR/projects/oryn-engine/vendor/oryn_protocol-$PROTOCOL_VERSION-py3-none-any.whl"

print "Building Oryn SDK from source…"
node "$WORKSPACE_DIR/projects/oryn-protocol/scripts/export-sdk-task-types.mjs" "$WORKSPACE_DIR/projects/oryn-sdk/src/task-contracts.ts"
/usr/bin/install -m 0644 "$WORKSPACE_DIR/projects/oryn-protocol/typescript/src/model-selection.ts" "$WORKSPACE_DIR/projects/oryn-sdk/src/model-selection.ts"
/usr/bin/install -m 0644 "$WORKSPACE_DIR/projects/oryn-protocol/fixtures/model-selection/golden.json" "$WORKSPACE_DIR/projects/oryn-sdk/src/__tests__/fixtures/model-selection.json"
pnpm --dir "$WORKSPACE_DIR/projects/oryn-sdk" install --frozen-lockfile "${PNPM_FETCH_FLAGS[@]}"
pnpm --dir "$WORKSPACE_DIR/projects/oryn-sdk" build
pnpm --dir "$WORKSPACE_DIR/projects/oryn-sdk" pack --pack-destination "$ARTIFACT_DIR"
SDK_VERSION="$(node -p 'require(process.argv[1]).version' "$WORKSPACE_DIR/projects/oryn-sdk/package.json")"
/usr/bin/install -m 0644 "$ARTIFACT_DIR/ocno-oryn-sdk-$SDK_VERSION.tgz" "$WORKSPACE_DIR/projects/oryn-examples/vendor/ocno-oryn-sdk-$SDK_VERSION.tgz"

print "Installing public components…"
# Protocol/SDK development candidates retain their package version. Refresh only
# their local artifact identities while retaining the other locked dependencies.
pnpm --dir "$WORKSPACE_DIR/projects/oryn-browser" install --no-frozen-lockfile "${PNPM_FETCH_FLAGS[@]}"
node "$WORKSPACE_DIR/scripts/prepare-electron.mjs"
# A cache refresh alone retains the old hash for same-version source candidates.
# Re-resolve only this exact, local-path dependency to record the rebuilt bytes.
uv lock --project "$WORKSPACE_DIR/projects/oryn-engine" --python "$PYTHON_VERSION" --upgrade-package oryn-protocol "${UV_FETCH_FLAGS[@]}"
uv sync --project "$WORKSPACE_DIR/projects/oryn-engine" --python "$PYTHON_VERSION" --extra dev --frozen "${UV_FETCH_FLAGS[@]}"
pnpm --dir "$WORKSPACE_DIR/projects/oryn-examples" install --no-frozen-lockfile "${PNPM_FETCH_FLAGS[@]}"
print "Oryn public source bootstrap complete."
