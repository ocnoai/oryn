{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oryn:task-profile:1",
  "title": "Oryn TaskProfile",
  "description": "Common public effective task contract. Registry validation is required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "profileId",
    "contract",
    "task",
    "inputModalities",
    "outputModalities",
    "inputSchemaRef",
    "resultSchemaRef",
    "features",
    "parameters",
    "limits",
    "streamingChannels",
    "extensions",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "task-profile"
    },
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "task": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 128
    },
    "inputModalities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text",
          "image",
          "audio",
          "video",
          "document"
        ]
      }
    },
    "outputModalities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text",
          "image",
          "audio",
          "video",
          "embedding",
          "structured"
        ]
      }
    },
    "inputSchemaRef": {
      "type": "string",
      "pattern": "^taskInput\\.[a-z][a-z0-9-]*-v[1-9][0-9]*$",
      "maxLength": 160
    },
    "resultSchemaRef": {
      "type": "string",
      "pattern": "^taskResult\\.[a-z][a-z0-9-]*-v[1-9][0-9]*$",
      "maxLength": 160
    },
    "features": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]{0,63}$": {
          "enum": [
            "supported",
            "unsupported",
            "unknown",
            "requires-input"
          ]
        }
      }
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "limits": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]{0,63}$": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "streamingChannels": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,63}$"
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "provenance": {
      "enum": [
        "runtime-tested",
        "runtime-declared",
        "adapter-derived",
        "runtime-fallback"
      ]
    },
    "thinking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "default"
      ],
      "properties": {
        "support": {
          "enum": [
            "switchable",
            "fixed",
            "unsupported",
            "unknown"
          ]
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "support": {
                "const": "fixed"
              }
            },
            "required": [
              "support"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$",
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "parameters": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]{0,63}$": {
          "$ref": "#/$defs/parameter"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputPointer",
        "valueSchema",
        "handling",
        "editable",
        "affects"
      ],
      "properties": {
        "inputPointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "maxLength": 256
        },
        "valueSchema": {
          "type": "object",
          "description": "A reviewed bounded JSON Schema fragment; validate separately and allow only locally registered references."
        },
        "default": {},
        "handling": {
          "enum": [
            "honored",
            "fixed",
            "unsupported",
            "requires-input"
          ]
        },
        "editable": {
          "type": "boolean"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "affects": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "result",
              "memory",
              "latency"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "handling": {
                "const": "fixed"
              }
            },
            "required": [
              "handling"
            ]
          },
          "then": {
            "required": [
              "default"
            ],
            "properties": {
              "editable": {
                "const": false
              },
              "valueSchema": {
                "required": [
                  "const"
                ],
                "type": "object",
                "properties": {
                  "const": {}
                }
              },
              "default": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "handling": {
                "const": "unsupported"
              }
            },
            "required": [
              "handling"
            ]
          },
          "then": {
            "not": {
              "required": [
                "default"
              ],
              "properties": {
                "default": {}
              }
            },
            "properties": {
              "editable": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "revision",
        "parameters"
      ],
      "properties": {
        "schemaRef": {
          "type": "string",
          "pattern": "^taskExtension\\.[a-zA-Z0-9.-]+$",
          "maxLength": 160
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    }
  }
}
