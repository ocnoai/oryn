{
  "name": "@ocno/oryn-browser-workspace",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ocno/oryn-browser dev",
    "build": "pnpm -r --if-present build",
    "runtime:assemble": "pnpm --filter @ocno/oryn-browser runtime:assemble",
    "package:mac:local": "pnpm --filter @ocno/oryn-browser package:mac:local",
    "package:mac:dev": "pnpm --filter @ocno/oryn-browser package:mac:dev",
    "package:mac:release": "pnpm --filter @ocno/oryn-browser package:mac:release",
    "test:packaged-runtime": "pnpm --filter @ocno/oryn-browser test:packaged-runtime",
    "test:packaged": "pnpm --filter @ocno/oryn-browser test:packaged",
    "test": "pnpm -r --if-present test && pnpm test:release",
    "test:release": "node --test scripts/app-release-validation.test.mjs scripts/macos-security-policy.test.mjs scripts/macos-development.test.mjs scripts/macos-native-release-bindings.test.mjs scripts/macos-enclosing-signing.test.mjs scripts/macos-minimum-os.test.mjs scripts/macos-app-update-config.test.mjs",
    "release:publish": "node scripts/publish-app-update.mjs",
    "test:e2e": "pnpm --filter @ocno/oryn-browser test:e2e",
    "security:verify": "node scripts/verify-security-hardening.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "test:ui": "pnpm --filter @ocno/oryn-browser test:ui"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "builder-util-runtime": "9.7.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "yaml": "2.8.1"
  }
}
