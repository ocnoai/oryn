{
  "name": "@ocno/oryn-protocol",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Versioned Oryn Browser to Oryn Engine protocol bindings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsup": "8.5.1",
    "vitest": "4.1.10"
  }
}
