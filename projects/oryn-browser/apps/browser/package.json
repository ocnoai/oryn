{
  "name": "@ocno/oryn-browser",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Oryn Browser with a supervised local AI runtime",
  "author": "OCNO",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/build-browser-import-sandbox.mjs && node ../../scripts/build-download-safety.mjs && pnpm --filter @ocno/oryn-theme build",
    "dev": "node ../../scripts/run-source-dev.mjs",
    "prebuild": "node ../../scripts/build-browser-import-sandbox.mjs && node ../../scripts/build-download-safety.mjs && pnpm --filter @ocno/oryn-theme build",
    "build": "electron-vite build",
    "runtime:assemble": "node ../../scripts/assemble-engine-runtime.mjs",
    "package:mac:local": "ORYN_VERIFY_STAGED_RUNTIME=1 pnpm security:verify && pnpm build && node ../../scripts/package-macos-local.mjs",
    "package:mac:dev": "ORYN_VERIFY_STAGED_RUNTIME=1 pnpm security:verify && pnpm build && node ../../scripts/package-macos-development.mjs",
    "package:mac:inspect-test": "ORYN_VERIFY_STAGED_RUNTIME=1 pnpm security:verify && pnpm build && node ../../scripts/package-macos-local.mjs --inspect-test",
    "package:mac:release": "ORYN_VERIFY_STAGED_RUNTIME=1 pnpm security:verify && node ../../scripts/verify-release-credentials.mjs && pnpm build && node ../../scripts/package-macos-release.mjs",
    "test:packaged-runtime": "node ../../scripts/verify-packaged-runtime.mjs",
    "test:packaged": "node ../../scripts/run-electron-smoke.mjs --packaged",
    "test": "vitest run",
    "test:e2e": "pnpm build && node ../../scripts/run-electron-smoke.mjs",
    "security:verify": "node ../../scripts/verify-security-hardening.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:ui": "pnpm build && node ../../scripts/run-source-ui.mjs"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "dependencies": {
    "@ocno/oryn-protocol": "file:../../vendor/ocno-oryn-protocol-0.1.0.tgz",
    "@ocno/oryn-registry": "0.1.0",
    "@ocno/oryn-theme": "workspace:^",
    "electron-updater": "6.8.9",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "1.3.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.1.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "jsdom": "^30.1.2",
    "node-api-headers": "1.9.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
