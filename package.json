{
  "name": "oryn",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/ocnoai/oryn.git" },
  "packageManager": "pnpm@10.6.5",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "bootstrap": "./scripts/bootstrap",
    "predev": "pnpm --dir components/examples build",
    "dev": "ORYN_ENGINE_DIR=$PWD/components/engine ORYN_ENGINE_PYTHON=$PWD/components/engine/.venv/bin/python pnpm --dir components/browser dev",
    "dev:browser": "pnpm dev",
    "dev:engine": "uv run --project components/engine python -m oryn_engine",
    "build": "./scripts/build-all",
    "test": "./scripts/test-all",
    "typecheck": "pnpm --dir components/protocol typecheck && pnpm --dir components/sdk typecheck && pnpm --dir components/browser typecheck && pnpm --dir components/examples typecheck",
    "lint": "pnpm --dir components/browser lint && cd components/engine && uv run ruff check . && uv run ruff format --check .",
    "test:e2e": "ORYN_ENGINE_DIR=$PWD/components/engine ORYN_ENGINE_PYTHON=$PWD/components/engine/.venv/bin/python pnpm --dir components/browser test:e2e",
    "security:verify": "pnpm --dir components/browser security:verify",
    "docs:check": "node scripts/check-public-docs.mjs --all",
    "vendor:verify": "node scripts/verify-vendor-artifacts.mjs",
    "package:mac:local": "./scripts/package-macos-developer-alpha local",
    "package:mac:release": "./scripts/package-macos-developer-alpha release"
  }
}
